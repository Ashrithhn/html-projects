<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nexus Core Hub</title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="icon"
        href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🧭</text></svg>"
        type="image/svg+xml">
    <style>
        .hub-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05);
            padding: 50px 40px;
            max-width: 800px;
            width: 100%;
            margin: 40px auto;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.8);
        }

        .nav-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
            margin: 40px 0;
        }

        .nav-card {
            background: #f7fafc;
            border-radius: 15px;
            padding: 25px 20px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.02);
            transition: all 0.3s ease;
            text-decoration: none;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: inherit;
            border: 1px solid transparent;
        }

        .nav-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.15);
            border-color: rgba(102, 126, 234, 0.2);
            text-decoration: none;
        }

        .nav-card h3 {
            color: var(--text-primary);
            margin-bottom: 10px;
            font-size: 1.25rem;
        }

        .nav-card p {
            font-size: 0.95rem;
            color: var(--text-secondary);
            margin-bottom: 0;
            line-height: 1.5;
        }

        @media (max-width: 768px) {
            .hub-card {
                padding: 30px 20px;
                margin: 20px auto;
            }

            .nav-grid {
                grid-template-columns: 1fr;
                gap: 15px;
                margin: 30px 0;
            }
        }
    </style>
</head>

<body>
    <%- include('partials/header') %>

        <div class="container">
            <div class="hub-card">
                <h1 class="gradient-text">Nexus Core Collection</h1>
                <p>Explore our library of HTML, CSS, and JS web projects designed for modern standards. Search and navigate
                    through the hub below.</p>

                <div class="nav-grid">
                    <a href="/" class="nav-card">
                        <h3>Landing Page</h3>
                        <p>Interactive landing page with animated project cards</p>
                    </a>
                    <a href="/about" class="nav-card">
                        <h3>About</h3>
                        <p>Learn more about me and my tech stack</p>
                    </a>
                    <a href="/portfolio" class="nav-card">
                        <h3>Portfolio</h3>
                        <p>Professional portfolio showcasing skills and projects</p>
                    </a>
                    <a href="/contact" class="nav-card">
                        <h3>Contact Form</h3>
                        <p>Complete contact page with form validation</p>
                    </a>
                </div>

                <a href="https://github.com/NexusCore" class="btn">View on GitHub</a>
            </div>
        </div>

        <%- include('partials/footer') %>

            <script src="/script.js"></script>
</body>

</html>